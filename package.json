{
  "name": "openbin",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "version": "0.2.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:cloud": "BUILD_EDITION=cloud vite",
    "dev:server": "cd server && npm run dev",
    "dev:all": "npx concurrently -n api,web -c blue,green \"npm run dev:server\" \"npm run dev\"",
    "dev:cloud:all": "npx concurrently -n api,web -c blue,green \"npm run dev:server\" \"npm run dev:cloud\"",
    "build": "tsc && cp server/openapi.yaml public/api-docs/openapi.yaml && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "npx biome check src/",
    "check": "tsc --noEmit && cd server && npx tsc --noEmit",
    "prepare": "husky"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "html5-qrcode": "^2.3.8",
    "i18next": "^26.3.6",
    "i18next-browser-languagedetector": "^8.2.1",
    "i18next-resources-to-backend": "^1.2.3",
    "jspdf": "^4.2.0",
    "lucide-react": "^0.563.0",
    "qr-code-styling": "^1.9.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^17.0.11",
    "react-router-dom": "^6.30.3",
    "tailwind-merge": "^3.4.0",
    "uuid": "^13.0.0"
  },
  "overrides": {
    "serialize-javascript": "^7.0.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.2",
    "@tailwindcss/vite": "^4.2.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^5.1.4",
    "concurrently": "^9.2.1",
    "happy-dom": "^20.8.9",
    "husky": "^9.1.7",
    "i18next-cli": "^1.67.8",
    "lint-staged": "^16.4.0",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "vite": "^6.4.1",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^4.0.18"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": "npx biome check --no-errors-on-unmatched",
    "server/src/**/*.{ts,tsx}": "npx biome check --no-errors-on-unmatched"
  }
}
